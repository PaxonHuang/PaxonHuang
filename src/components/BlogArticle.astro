---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;

// Compute reading time from markdown body
const wordCount = (post.body ?? '').trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 220));

// Compute P/N: DOC-YYYYMMDD-NNN (datasheet-style identifier)
const date = post.data.date;
const ymd = `${date.getFullYear()}${String(date.getMonth() + 1).padStart(2, '0')}${String(date.getDate()).padStart(2, '0')}`;
const sequence = String(((date.getDate() * 31 + date.getMonth() * 17) % 999) + 1).padStart(3, '0');
const partNumber = `DOC-${ymd}-${sequence}`;

const dateStr = date.toISOString().slice(0, 10);

// Filter to h2 only for inline section nav (avoid clutter)
const sectionNav = headings.filter((h) => h.depth === 2);
---

<!-- Top reading progress bar: 3px line + current section label -->
<div
  id="reading-progress"
  class="fixed top-0 left-0 right-0 z-50 pointer-events-none"
  aria-hidden="true"
>
  <div class="h-[3px] w-full bg-slate-200/40 dark:bg-slate-800/40 backdrop-blur-sm">
    <div
      id="reading-progress-fill"
      class="h-full w-0 bg-gradient-to-r from-primary-500 via-primary-400 to-accent-500 transition-[width] duration-75 ease-out"
    >
    </div>
  </div>
  <div
    id="reading-progress-label"
    class="absolute top-3 right-4 hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/85 dark:bg-dark-900/85 backdrop-blur-md border border-slate-200/60 dark:border-slate-800/60 shadow-sm font-mono text-[10px] tracking-wider uppercase text-slate-500 dark:text-slate-400 transition-opacity duration-200 opacity-0"
  >
    <span class="w-1.5 h-1.5 rounded-full bg-primary-500 animate-pulse"></span>
    <span id="reading-progress-text">TOP</span>
  </div>
</div>

<article class="mx-auto w-full max-w-[68ch] px-4 sm:px-6 py-8 sm:py-12">
  <!-- Back link -->
  <a
    href="/blog"
    class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors mb-10"
  >
    <span aria-hidden="true">←</span> Back to index
  </a>

  <!-- Datasheet cover header -->
  <header class="mb-12 pb-8 border-b-2 border-dashed border-slate-300 dark:border-slate-700">
    <!-- Top metadata row: P/N + status -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 font-mono text-[11px] uppercase tracking-[0.15em]">
      <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
        <span class="opacity-60">#</span>
        <span>P/N: <span class="text-slate-700 dark:text-slate-300 font-semibold">{partNumber}</span></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-emerald-300 dark:border-emerald-700 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 font-bold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          PUBLISHED
        </span>
        <span class="px-2 py-0.5 rounded border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400">
          REV 1.0
        </span>
      </div>
    </div>

    <!-- Title -->
    <h1
      class="font-display font-black text-3xl sm:text-4xl md:text-5xl leading-[1.1] tracking-tight text-slate-900 dark:text-slate-50 mb-6"
    >
      {post.data.title}
    </h1>

    <!-- Excerpt as subtitle -->
    <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-8 italic border-l-2 border-primary-500 pl-4">
      {post.data.excerpt}
    </p>

    <!-- Spec table -->
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3 p-4 sm:p-5 rounded-lg bg-slate-50 dark:bg-dark-900 border border-slate-200 dark:border-slate-800 font-mono text-xs">
      <div class="flex flex-col gap-0.5">
        <dt class="uppercase tracking-wider text-slate-400 dark:text-slate-500 text-[10px]">Date</dt>
        <dd class="text-slate-800 dark:text-slate-200 font-semibold">{dateStr}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="uppercase tracking-wider text-slate-400 dark:text-slate-500 text-[10px]">Category</dt>
        <dd class="text-slate-800 dark:text-slate-200 font-semibold">{post.data.category}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="uppercase tracking-wider text-slate-400 dark:text-slate-500 text-[10px]">Read Time</dt>
        <dd class="text-slate-800 dark:text-slate-200 font-semibold">
          {readingTime} min
        </dd>
      </div>
      <div class="flex flex-col gap-0.5 col-span-2 sm:col-span-1">
        <dt class="uppercase tracking-wider text-slate-400 dark:text-slate-500 text-[10px]">Words</dt>
        <dd class="text-slate-800 dark:text-slate-200 font-semibold">{wordCount.toLocaleString()}</dd>
      </div>
      <div class="flex flex-col gap-0.5 col-span-2 sm:col-span-4 pt-3 border-t border-slate-200 dark:border-slate-800">
        <dt class="uppercase tracking-wider text-slate-400 dark:text-slate-500 text-[10px] mb-1">Tags</dt>
        <dd class="flex flex-wrap gap-1.5">
          {post.data.tags.map((tag: string) => (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-900 dark:bg-slate-100 text-slate-100 dark:text-slate-900">
              {tag}
            </span>
          ))}
        </dd>
      </div>
    </dl>
  </header>

  <!-- Inline section nav (replaces right sidebar TOC) -->
  {
    sectionNav.length > 0 && (
      <nav
        aria-label="Article sections"
        class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-800"
      >
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500 mb-2">
          § Sections
        </div>
        <ol class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
          {sectionNav.map((s, i) => (
            <li>
              <a
                href={`#${s.slug}`}
                data-section-target={s.slug}
                class="text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
              >
                <span class="font-mono text-xs text-slate-400 dark:text-slate-500 mr-1">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {s.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <!-- Article body (static HTML rendered by Astro) -->
  <div
    id="article-body"
    class="prose prose-lg dark:prose-invert max-w-none
      prose-headings:font-display prose-headings:font-black prose-headings:tracking-tight
      prose-headings:scroll-mt-24
      prose-h1:hidden
      prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-slate-200 prose-h2:dark:border-slate-800
      prose-h3:text-xl prose-h3:sm:text-2xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:leading-[1.8] prose-p:text-slate-700 dark:prose-p:text-slate-300
      prose-a:font-semibold prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-a:no-underline hover:prose-a:underline
      prose-code:font-mono prose-code:text-[0.9em] prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-primary-700 dark:prose-code:text-primary-300 prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 prose-pre:shadow-lg
      prose-pre:code:bg-transparent prose-pre:code:p-0 prose-pre:code:text-slate-200
      prose-blockquote:border-l-4 prose-blockquote:border-primary-500 prose-blockquote:bg-slate-50 dark:prose-blockquote:bg-slate-900/50 prose-blockquote:not-italic
      prose-strong:text-slate-900 dark:prose-strong:text-white
      prose-li:my-1
      prose-img:rounded-lg prose-img:border prose-img:border-slate-200 dark:prose-img:border-slate-800"
  >
    <slot />
  </div>

  <!-- Article footer: end-of-datasheet marker -->
  <footer class="mt-16 pt-6 border-t-2 border-dashed border-slate-300 dark:border-slate-700 font-mono text-[11px] uppercase tracking-[0.15em] text-slate-400 dark:text-slate-500 text-center">
    ── END OF DOCUMENT ──
  </footer>
</article>

<script
  define:vars={{
    sectionSlugs: sectionNav.map((s) => s.slug),
    sectionLabels: sectionNav.map((s) => s.text),
  }}
>
  // Reading progress + active section tracker (vanilla JS, ~1KB)
  (() => {
    const fill = document.getElementById('reading-progress-fill');
    const labelEl = document.getElementById('reading-progress-label');
    const textEl = document.getElementById('reading-progress-text');
    if (!fill) return;

    let raf = 0;
    const updateProgress = () => {
      raf = 0;
      const article = document.getElementById('article-body');
      if (!article) return;
      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = article.offsetHeight;
      const viewportH = window.innerHeight;
      const scrolled = window.scrollY - articleTop;
      const total = Math.max(1, articleHeight - viewportH);
      const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
      fill.style.width = pct + '%';

      // Active section: find the last heading whose top is above 120px
      const links = document.querySelectorAll('[data-section-target]');
      let activeIdx = -1;
      links.forEach((link, i) => {
        const id = link.getAttribute('data-section-target');
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;
        const top = target.getBoundingClientRect().top;
        if (top < 120) activeIdx = i;
        // Toggle highlight class
        const isActive = i === activeIdx;
        if (isActive) {
          link.classList.add('text-primary-600', 'dark:text-primary-400', 'font-semibold');
          link.classList.remove('text-slate-600', 'dark:text-slate-400');
        } else {
          link.classList.remove('text-primary-600', 'dark:text-primary-400', 'font-semibold');
          link.classList.add('text-slate-600', 'dark:text-slate-400');
        }
      });

      if (labelEl && textEl) {
        if (activeIdx >= 0) {
          textEl.textContent = sectionLabels[activeIdx] ?? '';
          labelEl.classList.remove('opacity-0');
          labelEl.classList.add('opacity-100');
        } else {
          labelEl.classList.remove('opacity-100');
          labelEl.classList.add('opacity-0');
        }
      }
    };

    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(updateProgress);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateProgress();
  })();
</script>
